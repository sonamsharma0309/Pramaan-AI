# =====================================================================================
# Pramaan AI - configuration.   Setup:   1) cp .env.example .env   2) paste keys   3) docker compose up --build
# Every value is OPTIONAL. With an empty .env the app runs fully offline in fallback mode
# (template letters, local TF-IDF retrieval, SQLite, no email). NEVER commit your real .env.
# =====================================================================================

# ---------- Core ----------
# Public URL of the app (used in emailed links). Local: http://localhost:8000
APP_URL=http://localhost:8000
# true only for local testing: forgot-password / verify links are returned in the API response. Keep false in production.
DEV_MODE=false
# Signing key for JWTs. Leave empty to auto-generate and persist in the data volume.
# Or make one:  python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=
# true when served over HTTPS (marks cookies Secure)
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API cross-site. Empty = same-origin only (recommended).
CORS_ORIGINS=
# Require users to verify their email before signing in (needs SMTP below, or DEV_MODE=true to test)
REQUIRE_VERIFIED=false

# ---------- Database ----------
# Empty = SQLite file in ./data. docker compose sets this to the bundled PostgreSQL automatically.
# Manual PostgreSQL example: postgresql://user:password@host:5432/pramaan
DATABASE_URL=
POSTGRES_DB=pramaan
POSTGRES_USER=pramaan
# CHANGE THIS before exposing the stack anywhere
POSTGRES_PASSWORD=

# ---------- AI letters (optional) ----------
# Leave everything here empty and the app still works: it writes cited letters from a built-in template.
# To get AI-written letters pick ONE provider below (FREE options first).
#
# LLM_PROVIDER: gemini | ollama | anthropic | openai_compatible   (empty = auto: first provider that has a key)
LLM_PROVIDER=gemini

# --- Option A (free, easiest): Google Gemini ---
# Key: https://aistudio.google.com -> "Get API key" -> Create API key (free tier, no card needed; has daily limits)
GEMINI_API_KEY=
# Pick a Flash model that your AI Studio shows as free. "gemini-flash-latest" always points to the newest Flash.
GEMINI_MODEL=gemini-flash-latest

# --- Option B (free, offline, private): Ollama running on your own PC ---
# Install from https://ollama.com then run:  ollama pull llama3.2:3b   (small PCs)  or  ollama pull llama3.1:8b  (8 GB+ RAM)
# Set LLM_PROVIDER=ollama. With Docker leave OLLAMA_BASE_URL empty (compose uses host.docker.internal). Without Docker use http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2:3b

# --- Option C (paid): Anthropic Claude ---
# Key: https://console.anthropic.com -> API Keys -> Create Key (needs prepaid credit)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Option D: any OpenAI-compatible API (Groq, OpenRouter free models, LM Studio, ...) ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Remove names, DOB, SSN, phone, email and MRN before anything is sent to the AI API (strongly recommended)
DEIDENTIFY_BEFORE_LLM=true
# Semantic retrieval with sentence-transformers (needs: pip install -r requirements-extra.txt; ~1 GB)
EMBEDDINGS=false

# ---------- Google sign-in (optional) ----------
# https://console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID -> Web application
# Add your APP_URL under "Authorised JavaScript origins". Paste the Client ID (NOT the secret).
GOOGLE_CLIENT_ID=

# ---------- Email (optional: reset links, verification, contact form) ----------
# Any SMTP service: Gmail (use an App Password), Brevo, SendGrid SMTP, Mailgun, Zoho.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Inbox that receives messages from the Contact / Partner form
CONTACT_TO=

# ---------- FHIR import (optional feature flag) ----------
# Public HAPI test server by default (synthetic data only). Use your hospital's FHIR R4 endpoint in real deployments.
FHIR_ENABLED=false
FHIR_BASE=https://hapi.fhir.org/baseR4

# ---------- Limits ----------
MAX_UPLOAD_MB=5
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Per-IP requests per minute: sign-in/sign-up style endpoints and the whole API
RATE_AUTH_PER_MIN=15
RATE_API_PER_MIN=240
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
